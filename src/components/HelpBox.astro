---
import site from '../data/site.json';
interface Props {
  heading?: string;
}
const { heading = "Not sure it's the right part?" } = Astro.props;
---

<aside class="helpbox">
  <h2>{heading}</h2>
  <p>
    Springs, pawls and solenoids can look alike and fit differently. Call and we'll check it with you, or send photos and
    we'll identify it. Troubleshooting help is free.
  </p>
  <p class="helpbox__phone"><a href={site.phoneHref}>{site.phone}</a></p>
  <p><a class="btn btn--ghost" href="/identify/">Send us photos</a></p>
</aside>

<style>
  .helpbox {
    border: 2px solid var(--black);
    border-radius: 4px;
    padding: 18px 20px;
    background: var(--white);
    border-left: 10px solid var(--yellow);
  }
  .helpbox h2 {
    font-size: 1.5rem;
    margin-bottom: 6px;
  }
  .helpbox__phone {
    margin: 0 0 12px;
  }
  .helpbox__phone a {
    font-family: var(--f-cond);
    font-weight: 800;
    font-size: 2rem;
    color: var(--black);
    text-decoration: none;
  }
  .helpbox p:last-child {
    margin: 0;
  }
</style>

---
import PartCard from './PartCard.astro';
import type { Part } from '../lib/catalog';
interface Props {
  parts: Part[];
  showBrandFilter?: boolean;
}
const { parts, showBrandFilter = true } = Astro.props;
const count = (arr: string[]) => {
  const m = new Map<string, number>();
  arr.forEach((x) => m.set(x, (m.get(x) ?? 0) + 1));
  return [...m.entries()].sort((a, b) => b[1] - a[1]);
};
const brandOpts = count(parts.flatMap((p) => p.data.brands));
const styleOpts = count(parts.flatMap((p) => p.data.style));
---

<div class="browser" data-browser>
  <aside class="filters" aria-label="Filter parts">
    <details open>
      <summary>Filter</summary>
      {
        showBrandFilter && brandOpts.length > 1 && (
          <fieldset>
            <legend>Brand on the turnstile</legend>
            {brandOpts.map(([b, n]) => (
              <label class="check">
                <input type="checkbox" name="brand" value={b} /> {b} <small>{n}</small>
              </label>
            ))}
          </fieldset>
        )
      }
      {
        styleOpts.length > 1 && (
          <fieldset>
            <legend>Type</legend>
            {styleOpts.map(([s, n]) => (
              <label class="check">
                <input type="checkbox" name="style" value={s} /> {s} <small>{n}</small>
              </label>
            ))}
          </fieldset>
        )
      }
      <fieldset>
        <legend>Availability</legend>
        <label class="check"><input type="checkbox" name="available" /> Hide sold out</label>
      </fieldset>
    </details>
  </aside>
  <div>
    <div class="browser__bar">
      <p class="browser__count" aria-live="polite"><span data-shown>{parts.length}</span> parts</p>
      <label class="browser__sort">
        Sort
        <select name="sort">
          <option value="catalog">Catalog order</option>
          <option value="sku">Part number</option>
          <option value="price-asc">Price, low to high</option>
          <option value="price-desc">Price, high to low</option>
        </select>
      </label>
    </div>
    <div class="grid" data-grid>
      {parts.map((p) => <PartCard part={p} />)}
    </div>
    <p class="browser__empty" data-empty hidden>
      Nothing matches those filters. Clear a filter, or <a href="/identify/">send us a photo</a> and we'll find it.
    </p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-browser]').forEach((root) => {
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-card]')];
    cards.forEach((c, i) => (c.dataset.idx = String(i)));
    const shown = root.querySelector('[data-shown]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const vals = (name: string) =>
      [...root.querySelectorAll<HTMLInputElement>(`input[name=${name}]:checked`)].map((i) => i.value);
    const apply = () => {
      const brands = vals('brand');
      const styles = vals('style');
      const avail = root.querySelector<HTMLInputElement>('input[name=available]')?.checked;
      let n = 0;
      for (const c of cards) {
        const cb = (c.dataset.brands || '').split('|');
        const cs = (c.dataset.style || '').split('|');
        const ok =
          (!brands.length || brands.some((b) => cb.includes(b))) &&
          (!styles.length || styles.some((s) => cs.includes(s))) &&
          (!avail || c.dataset.status !== 'sold-out');
        c.hidden = !ok;
        if (ok) n++;
      }
      shown.textContent = String(n);
      empty.hidden = n > 0;
    };
    const sort = () => {
      const how = root.querySelector<HTMLSelectElement>('select[name=sort]')!.value;
      const sku = (c: HTMLElement) => c.querySelector('.card__sku')?.textContent ?? '';
      const price = (c: HTMLElement) => (c.dataset.price ? Number(c.dataset.price) : NaN);
      const sorted = [...cards].sort((a, b) => {
        if (how === 'sku') return sku(a).localeCompare(sku(b), undefined, { numeric: true });
        if (how.startsWith('price')) {
          const pa = price(a), pb = price(b);
          if (isNaN(pa)) return 1;
          if (isNaN(pb)) return -1;
          return how === 'price-asc' ? pa - pb : pb - pa;
        }
        return Number(a.dataset.idx) - Number(b.dataset.idx);
      });
      sorted.forEach((c) => grid.appendChild(c));
    };
    root.addEventListener('change', (e) => {
      if ((e.target as HTMLElement).matches('select[name=sort]')) sort();
      else apply();
    });
    if (window.matchMedia('(max-width: 860px)').matches) root.querySelector('details')?.removeAttribute('open');
  });
</script>

<style>
  .browser {
    display: grid;
    grid-template-columns: 230px 1fr;
    gap: 32px;
    align-items: start;
  }
  .filters {
    position: sticky;
    top: 12px;
    font-size: var(--t-sm);
  }
  .filters summary {
    font-family: var(--f-cond);
    font-weight: 700;
    font-size: 1.3rem;
    cursor: pointer;
    margin-bottom: 8px;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 18px;
  }
  legend {
    font-weight: 700;
    margin-bottom: 6px;
  }
  .check {
    display: flex;
    gap: 8px;
    align-items: center;
    font-weight: 500;
    margin: 0 0 4px;
    cursor: pointer;
  }
  .check input {
    width: 18px;
    height: 18px;
    accent-color: var(--black);
  }
  .check small {
    color: var(--steel);
    margin-left: auto;
  }
  .browser__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }
  .browser__count {
    margin: 0;
    font-weight: 600;
  }
  .browser__sort {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
  }
  .browser__sort select {
    width: auto;
    padding: 6px 10px;
  }
  .browser__empty {
    padding: 24px;
    background: var(--bench);
  }
  @media (max-width: 860px) {
    .browser {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .filters {
      position: static;
      border: 2px solid var(--black);
      border-radius: 4px;
      padding: 8px 12px 0;
    }
  }
</style>
